# Copy to .env for Docker Compose overrides. Never commit credentials here.
# Blank uses port 8080. Set a different local port here if needed.
PIPELINE_PORT=
# Blank derives http://localhost:<port> from PIPELINE_PORT.
# For HTTPS, set the exact public origin and keep the upstream port private.
PIPELINE_ORIGIN=

# For manual use of compose.yaml + compose.dev.yaml, uncomment and set an
# existing dedicated development volume. deploy/dev instead reads its settings
# from data/dev/config.json and does not load .env.
# PIPELINE_DEV_VOLUME=internship-pipeline-dev-data

# Direct Python runtime only: export these explicitly when running without
# Compose. Python does not load .env, and Compose does not forward these keys.
# PORT=8080
# PIPELINE_DATA_DIR=./data
# PIPELINE_CONFIG=./data/config/settings.yaml
# PIPELINE_WEB_DIR=./web/build

# Optional infrastructure overrides read by the Python configuration loader.
# Paths are relative to the working directory. Export only the overrides needed.
# PIPELINE_DATABASE_PATH=./data/pipeline.sqlite3
# PIPELINE_ARTIFACT_DIR=./artifacts
# PIPELINE_COMPANIES_PATH=./config/companies.local.yaml
# PIPELINE_SEARCHES_PATH=./config/searches.local.yaml

# Configure Jev, OpenAI, Claude and OpenRouter keys, SMTP credentials and Google
# Sheets access in authenticated Settings after claiming the owner account.
# The app does not read provider credentials from environment variables.
