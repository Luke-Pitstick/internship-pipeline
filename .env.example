# Copy to .env for Docker Compose. Never commit actual credentials.
# Replace with `id -u` and `id -g` on the host so private bind mounts remain readable.
PIPELINE_UID=10001
PIPELINE_GID=10001
PIPELINE_NOTIFICATION_URLS=[]
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
RESUME_MATCHER_URL=http://resume-matcher:3000
