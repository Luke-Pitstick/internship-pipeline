# Optional Docker Compose interpolation values; never commit actual credentials.
# Change both values together when selecting a different localhost port.
PIPELINE_PORT=8080
PIPELINE_ORIGIN=http://localhost:8080
# HTTPS deployments: set the exact public origin and keep the upstream port private.
# Worker credentials are not loaded from this file by the Compose service.
# Existing operator worker settings live inside the persistent volume until T04/T05.
