{
  "rubric": {
    "version": "jev-eligibility-fit-v1",
    "criteria": {
      "role": "Is this opening explicitly an internship or co-op in software engineering, machine learning/AI research, data science, or PRODUCT management? Senior full-time, student developer without internship evidence, PROJECT management and finance roles violate this search requirement.",
      "authorization": "Does the candidate satisfy all mandatory citizenship, work authorization and visa sponsorship restrictions? If the posting omits these restrictions, choose not_stated; do not infer sponsorship from silence.",
      "education": "Does the candidate satisfy mandatory degree level, subject and enrollment requirements? Treat preferred graduate degrees as optional. Equivalent experience is an alternative; review when its adequacy is unclear.",
      "location": "Does the posting explicitly permit this candidate to work in the United States? Remote alone does not imply any country; explicit conflicting jurisdictions violate.",
      "required_skills": "Does confirmed candidate evidence satisfy all explicitly REQUIRED skills/experience? Missing preferred skills do not violate. Years thresholds are handled separately in code; missing proof of mandatory skill means ambiguous, not confirmed absence."
    },
    "outcomes": {
      "satisfied": "Explicit evidence confirms compatibility, or explicitly no restriction for this criterion.",
      "violated": "Explicit mandatory restriction conflicts with an explicitly confirmed candidate fact.",
      "not_stated": "The posting does not state the relevant requirement; compatibility cannot be confirmed.",
      "ambiguous": "Conflicting requirements or insufficient candidate evidence to decide."
    },
    "dimensions": {
      "skills": "Rate coverage of stated required and preferred skills by confirmed candidate facts.",
      "projects": "Rate demonstrated project relevance to the actual advertised responsibilities.",
      "responsibilities": "Rate alignment of actual duties with candidate software/data work experience.",
      "preferences": "Rate alignment with candidate stated Python/backend/data career preferences."
    },
    "levels": [
      "No demonstrated alignment or missing relevant information",
      "Limited alignment: only indirect evidence",
      "Substantial alignment: several direct overlaps but meaningful gaps",
